      "source": [
        "# ==============================================================================\n",
        "# 3. MOTOR DE CÁLCULO NORMATIVO NTC 4552 (MÓDULOS 1 AL 7)\n",
        "# ==============================================================================\n",
        "\n",
        "class CalculadoraNTC4552:\n",
        "    \"\"\"\n",
        "    Motor analítico que implementa la secuencia determinística de evaluación\n",
        "    de riesgo según NTC 4552-2 y dimensionamiento SIPRA según NTC 4552-3.\n",
        "    \"\"\"\n",
        "\n",
        "    @staticmethod\n",
        "    def modulo1_amenaza_ng(nk: Optional[float] = None, ng_directo: Optional[float] = None) -> float:\n",
        "        \"\"\"\n",
        "        Módulo 1: Amenaza Meteorológica (Ng / DDT)\n",
        "        Calcula Ng = 0.0017 * Nk^1.56 o utiliza la entrada directa de Ng.\n",
        "        \"\"\"\n",
        "        if ng_directo is not None and ng_directo > 0:\n",
        "            return float(ng_directo)\n",
        "        if nk is not None and nk > 0:\n",
        "            return 0.0017 * math.pow(nk, 1.56)\n",
        "        return 1.0\n",
        "\n",
        "    @staticmethod\n",
        "    def modulo2_areas_captura(L: float, W: float, H: float, Lc: float, rho: float) -> Dict[str, float]:\n",
        "        \"\"\"\n",
        "        Módulo 2: Áreas de Captura Equivalente (Ax en m²)\n",
        "        - Ad: Impactos directos a la estructura\n",
        "        - Am: Impactos cercanos a la estructura (envolvente 250 m)\n",
        "        - Al: Impactos directos a la acometida aérea (Lc <= 1000 m)\n",
        "        - Ai: Impactos cercanos a la acometida\n",
        "        \"\"\"\n",
        "        Lc_calc = min(max(Lc, 0.0), 1000.0) # Acotada por norma a 1000 m\n",
        "\n",
        "        Ad = (L * W) + (6.0 * H * (L + W)) + (9.0 * math.pi * (H ** 2))\n",
        "        Am = (500.0 * (L + W)) + (62500.0 * math.pi)\n",
        "        Al = 40.0 * Lc_calc\n",
        "        Ai = 25.0 * Lc_calc * math.sqrt(max(rho, 0.0))\n",
        "\n",
        "        return {\n",
        "            \"Ad\": Ad,\n",
        "            \"Am\": Am,\n",
        "            \"Al\": Al,\n",
        "            \"Ai\": Ai,\n",
        "            \"Lc_calc\": Lc_calc\n",
        "        }\n",
        "\n",
        "    @staticmethod\n",
        "    def modulo3_frecuencias_anuales(ng: float, areas: Dict[str, float],\n",
        "                                     cd: float, ce: float, ct: float) -> Dict[str, float]:\n",
        "        \"\"\"\n",
        "        Módulo 3: Frecuencias Anuales de Impactos Peligrosos (Nx en eventos/año)\n",
        "        Aplica el factor 10^-6 para conversión m² a km².\n",
        "        \"\"\"\n",
        "        Ad = areas[\"Ad\"]\n",
        "        Am = areas[\"Am\"]\n",
        "        Al = areas[\"Al\"]\n",
        "        Ai = areas[\"Ai\"]\n",
        "\n",
        "        ND = ng * Ad * cd * 1e-6\n",
        "        NM = ng * max(0.0, Am - Ad) * cd * 1e-6\n",
        "        NL = ng * Al * ce * ct * 1e-6\n",
        "        NI = ng * Ai * ce * ct * 1e-6\n",
        "\n",
        "        return {\n",
        "            \"ND\": ND,\n",
        "            \"NM\": NM,\n",
        "            \"NL\": NL,\n",
        "            \"NI\": NI\n",
        "        }\n",
        "\n",
        "    @staticmethod\n",
        "    def modulo4_perdidas_consecuentes(ra: float, ru: float, rp: float, rf: float, hz: float,\n",
        "                                      Lt: float, Lf: float, Lo: float,\n",
        "                                      tp: float, nz: float, nt: float) -> Dict[str, float]:\n",
        "        \"\"\"\n",
        "        Módulo 4: Pérdidas Consecuentes (Lx) para vidas humanas (R1)\n",
        "        Escaladas por factor de exposición temporal (tp / 8760) y espacial (nz / nt).\n",
        "        \"\"\"\n",
        "        factor_exp = (nz / nt) * (min(tp, 8760.0) / 8760.0) if nt > 0 else 0.0\n",
        "\n",
        "        LA = ra * Lt * factor_exp\n",
        "        LB = rp * rf * hz * Lf * factor_exp\n",
        "        LU = ru * Lt * factor_exp\n",
        "        LV = rp * rf * hz * Lf * factor_exp\n",
        "        LC = Lo * factor_exp\n",
        "        LM = Lo * factor_exp\n",
        "        LW = Lo * factor_exp\n",
        "        LZ = Lo * factor_exp\n",
        "\n",
        "        return {\n",
        "            \"LA\": LA, \"LB\": LB, \"LC\": LC, \"LM\": LM,\n",
        "            \"LU\": LU, \"LV\": LV, \"LW\": LW, \"LZ\": LZ,\n",
        "            \"factor_exposicion\": factor_exp\n",
        "        }\n",
        "\n",
        "    @staticmethod\n",
        "    def modulo5_probabilidades(clase_sipra: ClaseSIPRA,\n",
        "                               proteccion_pc: ProteccionPasoContacto,\n",
        "                               proteccion_dps: ProteccionDPS,\n",
        "                               apantallada: bool,\n",
        "                               uw_kv: float) -> Dict[str, float]:\n",
        "        \"\"\"\n",
        "        Módulo 5.1: Asignación de Probabilidades Condicionales de Daño (Px)\n",
        "        según Tablas 14 a 20 de la NTC 4552-2.\n",
        "        \"\"\"\n",
        "        # PA: Daño por tensiones de paso y contacto\n",
        "        PA = proteccion_pc.value\n",
        "\n",
        "        # PB: Daño físico directo según Clase de SIPRA (Tabla 15)\n",
        "        mapeo_pb = {\n",
        "            ClaseSIPRA.NINGUNO: 1.0,\n",
        "            ClaseSIPRA.CLASE_IV: 0.20,\n",
        "            ClaseSIPRA.CLASE_III: 0.10,\n",
        "            ClaseSIPRA.CLASE_II: 0.05,\n",
        "            ClaseSIPRA.CLASE_I: 0.02\n",
        "        }\n",
        "        PB = mapeo_pb.get(clase_sipra, 1.0)\n",
        "\n",
        "        # PC: Fallas por impacto directo a estructura = PSPD (Tabla 16)\n",
        "        PC = proteccion_dps.value\n",
        "\n",
        "        # PM: Fallas por acople magnético cercano (LEMP)\n",
        "        # Con blindaje estándar o si hay DPS coordinado: min(PMS, PDPS)\n",
        "        PMS = 0.50 if clase_sipra != ClaseSIPRA.NINGUNO else 1.0\n",
        "        PM = min(PMS, PC) if proteccion_dps != ProteccionDPS.SIN_DPS else PMS\n",
        "\n",
        "        # PLD y PLI para acometidas (Tablas 19 y 20 aproximadas por apantallamiento y Uw)\n",
        "        if apantallada:\n",
        "            pld = 0.10 if uw_kv >= 2.5 else 0.30\n",
        "            pli = 0.02 if uw_kv >= 2.5 else 0.06\n",
        "        else:\n",
        "            pld = 1.0\n",
        "            pli = 0.40 if uw_kv >= 2.5 else 1.0\n",
        "\n",
        "        # PU: Choque por acometida\n",
        "        PU = min(PC, pld) * (0.1 if proteccion_pc != ProteccionPasoContacto.SIN_PROTECCION else 1.0)\n",
        "        # PV: Daño físico por acometida\n",
        "        PV = min(PC, pld)\n",
        "        # PW: Daño sistemas por impactos en acometida\n",
        "        PW = min(PC, pld)\n",
        "        # PZ: Daño sistemas por impactos cercanos a acometida\n",
        "        PZ = min(PC, pli)\n",
        "\n",
        "        return {\n",
        "            \"PA\": PA, \"PB\": PB, \"PC\": PC, \"PM\": PM,\n",
        "            \"PU\": PU, \"PV\": PV, \"PW\": PW, \"PZ\": PZ\n",
        "        }\n",
        "\n",
        "    @staticmethod\n",
        "    def modulo5_componentes_riesgo(frecuencias: Dict[str, float],\n",
        "                                   probabilidades: Dict[str, float],\n",
        "                                   perdidas: Dict[str, float],\n",
        "                                   NDa: float = 0.0) -> Dict[str, float]:\n",
        "        \"\"\"\n",
        "        Módulo 5.2: Cálculo de las 8 Componentes Individuales de Riesgo (Rx = Nx * Px * Lx)\n",
        "        Aplica estrictamente la regla condicional: Si (NI - NL) <= 0 => RZ = 0.\n",
        "        \"\"\"\n",
        "        ND = frecuencias[\"ND\"]\n",
        "        NM = frecuencias[\"NM\"]\n",
        "        NL = frecuencias[\"NL\"]\n",
        "        NI = frecuencias[\"NI\"]\n",
        "\n",
        "        PA, PB, PC, PM = probabilidades[\"PA\"], probabilidades[\"PB\"], probabilidades[\"PC\"], probabilidades[\"PM\"]\n",
        "        PU, PV, PW, PZ = probabilidades[\"PU\"], probabilidades[\"PV\"], probabilidades[\"PW\"], probabilidades[\"PZ\"]\n",
        "\n",
        "        LA, LB, LC, LM = perdidas[\"LA\"], perdidas[\"LB\"], perdidas[\"LC\"], perdidas[\"LM\"]\n",
        "        LU, LV, LW, LZ = perdidas[\"LU\"], perdidas[\"LV\"], perdidas[\"LW\"], perdidas[\"LZ\"]\n",
        "\n",
        "        RA = ND * PA * LA\n",
        "        RB = ND * PB * LB\n",
        "        RC = ND * PC * LC\n",
        "        RM = NM * PM * LM\n",
        "\n",
        "        RU = (NL + NDa) * PU * LU\n",
        "        RV = (NL + NDa) * PV * LV\n",
        "        RW = (NL + NDa) * PW * LW\n",
        "\n",
        "        # Regla condicional estricta: Si (NI - NL) <= 0 => RZ = 0\n",
        "        delta_N = NI - NL\n",
        "        if delta_N <= 0.0:\n",
        "            RZ = 0.0\n",
        "        else:\n",
        "            RZ = delta_N * PZ * LZ\n",
        "\n",
        "        return {\n",
        "            \"RA\": RA, \"RB\": RB, \"RC\": RC, \"RM\": RM,\n",
        "            \"RU\": RU, \"RV\": RV, \"RW\": RW, \"RZ\": RZ,\n",
        "            \"delta_N\": delta_N\n",
        "        }\n",
        "\n",
        "    @classmethod\n",
        "    def evaluar_instalacion_completa(cls, estructura: EstructuraEntrada) -> Dict[str, Any]:\n",
        "        \"\"\"\n",
        "        Ejecuta la secuencia completa de los 7 módulos técnicos para la estructura dada.\n",
        "        Retorna un diccionario completo con todos los resultados analíticos.\n",
        "        \"\"\"\n",
        "        # Módulo 1\n",
        "        ng = cls.modulo1_amenaza_ng(estructura.nivel_ceraunico_nk, estructura.densidad_ddt_ng)\n",
        "\n",
        "        # Módulo 2\n",
        "        areas = cls.modulo2_areas_captura(\n",
        "            L=estructura.longitud_l,\n",
        "            W=estructura.ancho_w,\n",
        "            H=estructura.altura_h,\n",
        "            Lc=estructura.acometida.longitud_m,\n",
        "            rho=estructura.acometida.resistividad_suelo_ohm_m\n",
        "        )\n",
        "\n",
        "        # Módulo 3\n",
        "        frecuencias = cls.modulo3_frecuencias_anuales(\n",
        "            ng=ng,\n",
        "            areas=areas,\n",
        "            cd=estructura.topografia.value,\n",
        "            ce=estructura.acometida.entorno.value,\n",
        "            ct=estructura.acometida.desacoplo.value\n",
        "        )\n",
        "\n",
        "        # Módulo 4\n",
        "        perdidas = cls.modulo4_perdidas_consecuentes(\n",
        "            ra=estructura.tipo_piso_exterior.value,\n",
        "            ru=estructura.tipo_piso_interior.value,\n",
        "            rp=estructura.medidas_incendio.value,\n",
        "            rf=estructura.riesgo_incendio.value,\n",
        "            hz=estructura.peligro_especial.value,\n",
        "            Lt=estructura.perdida_base_lesiones_lt,\n",
        "            Lf=estructura.perdida_base_dano_fisico_lf,\n",
        "            Lo=estructura.perdida_base_sistemas_lo,\n",
        "            tp=estructura.horas_permanencia_tp,\n",
        "            nz=estructura.personas_en_zona_nz,\n",
        "            nt=estructura.personas_totales_nt\n",
        "        )\n",
        "\n",
        "        # Módulo 5.1\n",
        "        probabilidades = cls.modulo5_probabilidades(\n",
        "            clase_sipra=estructura.clase_sipra,\n",
        "            proteccion_pc=estructura.proteccion_paso_contacto,\n",
        "            proteccion_dps=estructura.proteccion_dps,\n",
        "            apantallada=estructura.acometida.apantallada,\n",
        "            uw_kv=estructura.acometida.tension_soportable_uw_kv\n",
        "        )\n",
        "\n",
        "        # Módulo 5.2\n",
        "        componentes = cls.modulo5_componentes_riesgo(\n",
        "            frecuencias=frecuencias,\n",
        "            probabilidades=probabilidades,\n",
        "            perdidas=perdidas,\n",
        "            NDa=estructura.acometida.descargas_estructura_adyacente_nda\n",
        "        )\n",
        "\n",
        "        # Módulo 6: Integración frente a RT1 = 1e-5\n",
        "        RT1 = 1e-5\n",
        "        R_personas = componentes[\"RA\"] + componentes[\"RB\"] + componentes[\"RU\"] + componentes[\"RV\"]\n",
        "        R_sistemas = componentes[\"RC\"] + componentes[\"RM\"] + componentes[\"RW\"] + componentes[\"RZ\"]\n",
        "\n",
        "        if estructura.contiene_sistemas_vitales:\n",
        "            R1 = R_personas + R_sistemas\n",
        "        else:\n",
        "            R1 = R_personas\n",
        "\n",
        "        es_segura = (R1 <= RT1)\n",
        "\n",
        "        # Aportes porcentuales\n",
        "        aportes_pct = {}\n",
        "        if R1 > 0:\n",
        "            for k in [\"RA\", \"RB\", \"RC\", \"RM\", \"RU\", \"RV\", \"RW\", \"RZ\"]:\n",
        "                if not estructura.contiene_sistemas_vitales and k in [\"RC\", \"RM\", \"RW\", \"RZ\"]:\n",
        "                    aportes_pct[k] = 0.0\n",
        "                else:\n",
        "                    aportes_pct[k] = (componentes[k] / R1) * 100.0\n",
        "        else:\n",
        "            for k in [\"RA\", \"RB\", \"RC\", \"RM\", \"RU\", \"RV\", \"RW\", \"RZ\"]:\n",
        "                aportes_pct[k] = 0.0\n",
        "\n",
        "        # Módulo 7: Dimensionamiento SIPRA\n",
        "        sipra_params = TABLA_SIPRA_NTC4552_3.get(estructura.clase_sipra, TABLA_SIPRA_NTC4552_3[ClaseSIPRA.NINGUNO])\n",
        "\n",
        "        diagnostico_texto = \"INTRÍNSECAMENTE SEGURA\" if es_segura else \"REQUIERE SIPRA MANDATORIO\"\n",
        "\n",
        "        return {\n",
        "            \"ng\": ng,\n",
        "            \"areas\": areas,\n",
        "            \"frecuencias\": frecuencias,\n",
        "            \"perdidas\": perdidas,\n",
        "            \"probabilidades\": probabilidades,\n",
        "            \"componentes\": componentes,\n",
        "            \"R_personas\": R_personas,\n",
        "            \"R_sistemas\": R_sistemas,\n",
        "            \"R1\": R1,\n",
        "            \"RT1\": RT1,\n",
        "            \"es_segura\": es_segura,\n",
        "            \"diagnostico_texto\": diagnostico_texto,\n",
        "            \"aportes_pct\": aportes_pct,\n",
        "            \"sipra_params\": sipra_params,\n",
        "            \"estructura\": estructura\n",
        "        }\n",
        "\n",
        "print(\"✅ Motor de cálculo NTC 4552 (Módulos 1 a 7) compilado correctamente.\")\n"
      ]
