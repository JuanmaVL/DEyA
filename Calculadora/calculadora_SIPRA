        "\n",
        "def mostrar_resultados_visuales(res: Dict[str, Any]):\n",
        "    \"\"\"Despliega diagnósticos HTML, tablas Pandas formateadas y gráficos Matplotlib.\"\"\"\n",
        "    R1 = res[\"R1\"]\n",
        "    RT1 = res[\"RT1\"]\n",
        "    es_segura = res[\"es_segura\"]\n",
        "    comp = res[\"componentes\"]\n",
        "    frec = res[\"frecuencias\"]\n",
        "    prob = res[\"probabilidades\"]\n",
        "    perd = res[\"perdidas\"]\n",
        "    sipra = res[\"sipra_params\"]\n",
        "\n",
        "    # 1. Tarjeta de Diagnóstico\n",
        "    if es_segura:\n",
        "        color_fondo = \"#d4edda\"\n",
        "        color_borde = \"#28a745\"\n",
        "        color_texto = \"#155724\"\n",
        "        icono = \"✅\"\n",
        "        estado = \"INTRÍNSECAMENTE SEGURA\"\n",
        "        detalle_diag = f\"El riesgo total R₁ = {R1:.3e} no excede el umbral tolerable R_T1 = {RT1:.1e} año⁻¹.\"\n",
        "    else:\n",
        "        color_fondo = \"#f8d7da\"\n",
        "        color_borde = \"#dc3545\"\n",
        "        color_texto = \"#721c24\"\n",
        "        icono = \"⚠️\"\n",
        "        estado = \"REQUIERE SIPRA MANDATORIO\"\n",
        "        detalle_diag = f\"El riesgo total R₁ = {R1:.3e} SUPERA el umbral tolerable R_T1 = {RT1:.1e} año⁻¹. Se exige la implementación inmediata de un SIPRA y medidas de protección según NTC 4552-3 y RETIE.\"\n",
        "\n",
        "    html_banner = f\"\"\"\n",
        "    <div style=\"background-color: {color_fondo}; border: 2px solid {color_borde}; border-left: 8px solid {color_borde}; color: {color_texto}; padding: 18px 24px; border-radius: 8px; margin: 15px 0;\">\n",
        "        <h3 style=\"margin: 0 0 8px 0; font-size: 20px;\">{icono} DIAGNÓSTICO NORMATIVO: {estado}</h3>\n",
        "        <p style=\"margin: 0; font-size: 15px; font-weight: 500;\">{detalle_diag}</p>\n",
        "        <p style=\"margin: 5px 0 0 0; font-size: 13px; opacity: 0.9;\">\n",
        "            <b>Riesgo Calculado (R₁):</b> {R1:.4e} &nbsp;|&nbsp;\n",
        "            <b>Riesgo Tolerable (R_T1):</b> {RT1:.1e} año⁻¹ &nbsp;|&nbsp;\n",
        "            <b>Factor R₁ / R_T1:</b> {R1 / RT1:.2f}\n",
        "        </p>\n",
        "    </div>\n",
        "    \"\"\"\n",
        "    display(HTML(html_banner))\n",
